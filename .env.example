# Copy to .env and fill in. Never share or paste these keys.
OPENROUTER_API_KEY=your_openrouter_key_here   # required: all AI stages
TAVILY_API_KEY=your_tavily_key_here           # recommended: live company research (tavily.com)

# Which OpenRouter model each stage uses (defaults shown — uncomment to change).
# Tip: point LLM_AUDIT at a DIFFERENT model so the auditor isn't checking its own writing.
# LLM_PROFILE=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
# LLM_PITCH=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
# LLM_AUDIT=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free

# Optional tuning
# LLM_TIMEOUT=180              # seconds per model call
# LLM_MAX_TOKENS_PROFILE=3000  # max output tokens per call, per stage
# LLM_MAX_TOKENS_PITCH=8000
# LLM_MAX_TOKENS_AUDIT=1000
# OPENROUTER_REASONING=low     # low | medium | high | off | default
